PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=saaslb
FRONTEND_URL=http://localhost:5173

# simulate: apply bids immediately (local UI work)
# dodo: redirect to Dodo Payments hosted checkout
PAYMENTS_MODE=dodo

# test_mode -> https://test.dodopayments.com
# live_mode -> https://live.dodopayments.com
# The key, webhook secret, and product id must all come from this same mode.
# A live key against test_mode (or the reverse) makes checkout return 502.
DODO_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# One-time Pay What You Want product in the Dodo dashboard.
# Set minimum $1 and maximum $999,999 so any legal bid amount works.
DODO_PRODUCT_ID=
