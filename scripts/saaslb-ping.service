[Unit]
Description=Ping saaslb API so Render stays awake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this to your live health URL before enabling the unit.
Environment=PING_URL=https://saaslb-backend.onrender.com/api/health
Environment=PING_INTERVAL=300
ExecStart=/usr/local/bin/saaslb-ping
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
